[Unit]
Description=Waybar status bars (Hyprland)
Documentation=file:%h/.config/waybar/
After=dbus.service graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/.config/waybar/start-session.sh
ExecStop=%h/.config/waybar/stop-session.sh

# Started from Hyprland autostart only — not WantedBy=default.target
