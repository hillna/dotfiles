{
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "urgent": "",
      "empty": ""
    },
    "persistent-workspaces": {
      "DP-3": [1, 2, 3],
      "DP-2": [4, 5, 6, 7],
      "HDMI-A-1": [8, 9, 10]
    },
    "on-click": "activate",
    "cursor": false
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "separate-outputs": true
  },
  "custom/updates": {
    "exec": "$HOME/bin/check-updates",
    "interval": 1800,
    "format": "{}",
    "tooltip": false
  },
  "network": {
    "interval": 3,
    "format-wifi": " {essid} {ipaddr}",
    "format-ethernet": " {ifname} {ipaddr}",
    "format-disconnected": " not connected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "interval": 5,
    "format": "{icon}",
    "format-muted": "",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },
  "pulseaudio#xps13": {
    "interval": 5,
    "sink": "alsa_output.pci-0000_00_1f.3.analog-stereo",
    "format": "{icon}",
    "format-muted": "",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },
  "cpu": {
    "interval": 2,
    "format": "CPU: {usage}%"
  },
  "memory": {
    "interval": 2,
    "format": "RAM: {used:0.1f}G/{avail:0.1f}G"
  },
  "clock#date": {
    "interval": 1,
    "format": " {:%m-%d  %H:%M}",
    "tooltip-format": "<big>{:%Y-%m-%d}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "clock#time": {
    "interval": 1,
    "format": " {:%H:%M}"
  },
  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "interval": 10,
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "icon-size": 19,
    "spacing": 4
  }
}
