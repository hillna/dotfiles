{
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "urgent": "",
      "empty": ""
    },
    "persistent-workspaces": {
      "DP-2": [
        1,
        2,
        3
      ],
      "DP-1": [
        4,
        5,
        6,
        7
      ],
      "DP-3": [
        8,
        9,
        10
      ]
    },
    "on-click": "activate",
    "cursor": false
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "separate-outputs": true
  },
  "custom/updates": {
    "exec": "$HOME/bin/check-updates",
    "interval": 1800,
    "format": "{}",
    "tooltip": false
  },
  "network": {
    "interval": 3,
    "format-wifi": " {essid} {ipaddr}",
    "format-ethernet": " {ifname} {ipaddr}",
    "format-disconnected": " not connected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "interval": 5,
    "format": "{icon}",
    "format-muted": "",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "pulseaudio#xps13": {
    "interval": 5,
    "sink": "alsa_output.pci-0000_00_1f.3.analog-stereo",
    "format": "{icon}",
    "format-muted": "",
    "format-icons": [
      "",
      "",
      ""
    ],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "cpu": {
    "interval": 2,
    "format": "CPU: {usage}%"
  },
  "memory": {
    "interval": 2,
    "format": "RAM: {used:0.1f}G/{avail:0.1f}G"
  },
  "clock#date": {
    "interval": 1,
    "format": " {:%m-%d  %H:%M}",
    "tooltip-format": "<big>{:%Y-%m-%d}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "clock#time": {
    "interval": 1,
    "format": " {:%H:%M}"
  },
  "battery": {
    "bat": "BAT0",
    "adapter": "AC",
    "interval": 10,
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "icon-size": 19,
    "spacing": 4
  },
  "custom/deskflow": {
    "format": "",
    "tooltip-format": "Unstick Deskflow modifiers",
    "on-click": "$HOME/bin/deskflow-unstick --restart-if-running"
  },
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 2,
  "margin-left": 0,
  "margin-right": 2,
  "exclusive": true,
  "fixed-center": true,
  "output": "DP-1",
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "custom/updates",
    "network",
    "pulseaudio",
    "clock#date"
  ]
}
