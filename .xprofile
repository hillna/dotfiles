#if [[ -f /etc/xps13 ]]; then
#  setxkbmap -option ctrl:nocaps
#fi
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"

# Dark appearance for GTK / portals (libadwaita respects color-scheme)
$HOME/bin/apply-dark-theme

setxkbmap -option ctrl:nocaps

# Screen config
xsetroot -cursor_name left_ptr

#autorandr -l default
if [ -f /etc/xps13 ]; then
  $HOME/.screenlayout/xps13_single.sh
else
  $HOME/.screenlayout/triptic.sh
fi

# Xresources
[[ -f ~/.Xresources ]] && xrdb -merge -I$HOME ~/.Xresources

# fonts
xset +fp ~/.fonts

# set configs
if [ -f /etc/xps13 ]; then
  setxkbmap -layout us -option ctrl:nocaps
  ln -sf ~/.config/termite/config.xps13 ~/.config/termite/config
  ln -sf ~/.config/alacritty/alacritty.xps13 ~/.config/alacritty/alacritty.yml
else
  ln -sf ~/.config/termite/config.default ~/.config/termite/config
  ln -sf ~/.config/alacritty/alacritty.default ~/.config/alacritty/alacritty.yml
fi

# Color scheme
# wal -R

# compositing
$HOME/bin/compmgr --start

# keyring
eval $(ssh-agent -s)
