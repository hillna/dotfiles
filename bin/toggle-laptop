#!/usr/bin/env sh

is_hyprland() { [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; }

stop_input_leap() {
  killall input-leap 2>/dev/null
  killall input-leapc 2>/dev/null
}

start_input_leap() {
  input-leap >/dev/null 2>&1 &
}

stop_streamcontroller() {
  systemctl --user stop streamcontroller.service 2>/dev/null || true
}

restart_streamcontroller() {
  wait="${1:-3}"
  sleep "$wait"
  if systemctl --user is-active --quiet streamcontroller.service 2>/dev/null; then
    systemctl --user restart streamcontroller.service
  else
    systemctl --user start streamcontroller.service
  fi
}

if [ ! -e /tmp/laptop_mode ]; then
  touch /tmp/laptop_mode

  if is_hyprland; then
    $HOME/.jack/stop_jack.sh
    $HOME/bin/toggle-panel
    $HOME/.config/hypr/apply-layout.sh laptop
    systemctl --user restart waybar-session.service
    start_input_leap
    hyprctl dispatch focusmonitor DP-3
    hyprctl dispatch workspace 1
  else
    $HOME/.jack/stop_jack.sh

    sleep 5s
    $HOME/.screenlayout/single_left.sh

    $HOME/.config/bspwm/bspwmrc

    start_input_leap
  fi

  # Deck USB path leaves this machine; stop to avoid stale handles.
  stop_streamcontroller

  echo "laptop mode enabled"

else
  stop_input_leap

  if is_hyprland; then
    rm /tmp/laptop_mode
    $HOME/.config/hypr/apply-layout.sh desktop
    $HOME/.jack/start_jack.sh
    pgrep -x qjackctl >/dev/null || qjackctl &
    $HOME/bin/toggle-panel
    systemctl --user restart waybar-session.service
  else
    $HOME/.screenlayout/triptic.sh

    $HOME/.jack/start_jack.sh

    rm /tmp/laptop_mode
    $HOME/.config/bspwm/bspwmrc
  fi

  # Deck USB path returns; restart after I/O settles (native hotplug is unreliable).
  restart_streamcontroller

  echo "laptop mode disabled"

fi
