#!/usr/bin/env sh
# Emergency monitor restore when nwg-displays leaves outputs off.
# Usage: hypr-fix-displays [desktop|laptop]

layout="${1:-desktop}"

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
  echo "hypr-fix-displays: not a Hyprland session" >&2
  exit 1
fi

exec "$HOME/.config/hypr/apply-layout.sh" "$layout"
